    "import numpy as np\n",
    "from scipy.spatial.distance import cosine\n",
    "\n",
    "# =========================\n",
    "# CATALOGUE DE CONTENU\n",
    "# =========================\n",
    "\n",
    "CONTENT_CATALOG = {\n",
    "    \"technology\": [\n",
    "        \"Cours Python débutant\",\n",
    "        \"Podcast IA\",\n",
    "        \"Introduction Machine Learning\"\n",
    "    ],\n",
    "    \"fitness\": [\n",
    "        \"Programme fitness 30 jours\",\n",
    "        \"Yoga débutant\",\n",
    "        \"Nutrition sportive\"\n",
    "    ],\n",
    "    \"music\": [\n",
    "        \"Playlist Rock\",\n",
    "        \"Playlist Jazz\",\n",
    "        \"Histoire de la musique\"\n",
    "    ]\n",
    "}\n",
    "\n",
    "# =========================\n",
    "# CLASSE USER\n",
    "# =========================\n",
    "\n",
    "class User:\n",
    "    def __init__(self, user_id, name, interests, activities):\n",
    "        self.user_id = user_id\n",
    "        self.name = name\n",
    "        self.interests = interests\n",
    "        self.activities = activities\n",
    "\n",
    "# =========================\n",
    "# MOTEUR DE RECOMMANDATION\n",
    "# =========================\n",
    "\n",
    "class RecommendationEngine:\n",
    "\n",
    "    def __init__(self, catalog):\n",
    "        self.catalog = catalog\n",
    "\n",
    "    # ---- Recommandation principale\n",
    "    def recommend(self, user):\n",
    "\n",
    "        recommendations = []\n",
    "\n",
    "        # 1. Basé sur les intérêts\n",
    "        for interest in user.interests:\n",
    "            recommendations.extend(self.catalog.get(interest, []))\n",
    "\n",
    "        # 2. Logique dynamique selon activités\n",
    "        if any(\"AI\" in a or \"tech\" in a for a in user.activities):\n",
    "            recommendations.append(\"Cours avancé Intelligence Artificielle\")\n",
    "\n",
    "        if any(\"protein\" in a or \"bought protein\" in a for a in user.activities):\n",
    "            recommendations.append(\"Programme nutrition avancé\")\n",
    "\n",
    "        if any(\"playlist\" in a for a in user.activities):\n",
    "            recommendations.append(\"Playlist personnalisée premium\")\n",
    "\n",
    "        return recommendations\n",
    "\n",
    "# =========================\n",
    "# SIMILARITÉ ENTRE UTILISATEURS (SciPy)\n",
    "# =========================\n",
    "\n",
    "def vectorize(user):\n",
    "    \"\"\"\n",
    "    Convertit un utilisateur en vecteur binaire :\n",
    "    [tech, fitness, music]\n",
    "    \"\"\"\n",
    "    return [\n",
    "        int(\"technology\" in user.interests),\n",
    "        int(\"fitness\" in user.interests),\n",
    "        int(\"music\" in user.interests)\n",
    "    ]\n",
    "\n",
    "def similarity(user1, user2):\n",
    "    \"\"\"\n",
    "    Similarité cosinus entre deux utilisateurs\n",
    "    \"\"\"\n",
    "    v1 = vectorize(user1)\n",
    "    v2 = vectorize(user2)\n",
    "\n",
    "    return 1 - cosine(v1, v2)\n",
    "\n",
    "# =========================\n",
    "# EXEMPLE D'UTILISATION\n",
