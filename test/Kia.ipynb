    "import numpy as np\n",
    "import pandas as pd\n",
    "from faker import Faker\n",
    "from scipy.stats import chisquare, chi2_contingency\n",
    "from collections import Counter\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
<<<<<<< HEAD
    "# ==============================\n",
    "# PARAMETRES\n",
    "# ==============================\n",
    "\n",
    "fake = Faker('fr_FR')\n",
    "np.random.seed(42)\n",
    "\n",
    "INTERESTS = [\"technology\", \"fitness\", \"music\"]\n",
    "\n",
    "INTEREST_PROBA = [0.2, 0.5, 0.3]\n",
    "\n",
    "ACTIVITY_MAPPING = {\n",
    "    \"technology\": [\n",
    "        \"watched AI talk\",\n",
    "        \"read tech blog\",\n",
    "        \"bought headphones\"\n",
    "    ],\n",
    "    \"fitness\": [\n",
    "        \"ran 5km\",\n",
    "        \"yoga session\",\n",
    "        \"bought protein\"\n",
    "    ],\n",
    "    \"music\": [\n",
    "        \"listened to rock music\",\n",
    "        \"created playlist\",\n",
    "        \"bought concert ticket\"\n",
    "    ]\n",
    "}\n",
    "\n",
    "# ==============================\n",
    "# TABLE UTILISATEURS\n",
    "# ==============================\n",
    "\n",
    "users = []\n",
    "\n",
    "for user_id in range(1, 101):\n",
    "\n",
    "    age = np.random.randint(18, 66)\n",
    "\n",
    "    n_interests = np.random.randint(1, 4)\n",
    "\n",
    "    interests = list(\n",
    "        np.random.choice(\n",
    "            INTERESTS,\n",
    "            size=n_interests,\n",
    "            replace=False,\n",
    "            p=np.array(INTEREST_PROBA) / np.sum(INTEREST_PROBA)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    users.append({\n",
    "        \"user_id\": user_id,\n",
    "        \"name\": fake.name(),\n",
    "        \"age\": age,\n",
    "        \"interests\": interests\n",
    "    })\n",
    "\n",
    "df_users = pd.DataFrame(users)\n",
    "\n",
    "# ==============================\n",
    "# TABLE ACTIVITES\n",
    "# ==============================\n",
    "\n",
    "activities = []\n",
    "\n",
    "for _, user in df_users.iterrows():\n",
    "\n",
    "    n_actions = np.random.randint(3, 8)\n",
    "\n",
    "    for _ in range(n_actions):\n",
    "\n",
    "        interest = np.random.choice(user[\"interests\"])\n",
    "\n",
    "        action = np.random.choice(\n",
    "            ACTIVITY_MAPPING[interest]\n",
    "        )\n",
    "\n",
    "        timestamp = fake.date_time_between(\n",
    "            start_date=\"-30d\",\n",
    "            end_date=\"now\"\n",
    "        )\n",
    "\n",
    "        activities.append({\n",
    "            \"user_id\": user[\"user_id\"],\n",
    "            \"timestamp\": timestamp,\n",
    "            \"action\": action\n",
    "        })\n",
    "\n",
    "df_activity = pd.DataFrame(activities)\n",
    "\n",
    "# ==============================\n",
    "# NETTOYAGE\n",
    "# ==============================\n",
    "\n",
    "print(\"Valeurs manquantes :\")\n",
    "print(df_activity.isnull().sum())\n",
    "\n",
    "df_activity.drop_duplicates(inplace=True)\n",
    "\n",
    "# ==============================\n",
    "# ANALYSE DES INTERETS\n",
    "# ==============================\n",
    "\n",
    "all_interests = []\n",
    "\n",
    "for interests in df_users[\"interests\"]:\n",
    "    all_interests.extend(interests)\n",
    "\n",
    "interest_counts = pd.Series(all_interests).value_counts()\n",
    "\n",
    "print(\"\\nInterêts les plus fréquents :\")\n",
    "print(interest_counts)\n",
    "\n",
    "# ==============================\n",
    "# HEURES DE POINTE\n",
    "# ==============================\n",
    "\n",
    "df_activity[\"timestamp\"] = pd.to_datetime(\n",
    "    df_activity[\"timestamp\"]\n",
    ")\n",
    "\n",
    "df_activity[\"hour\"] = (\n",
    "    df_activity[\"timestamp\"].dt.hour\n",
    ")\n",
    "\n",
    "hour_counts = (\n",
    "    df_activity[\"hour\"]\n",
    "    .value_counts()\n",
    "    .sort_index()\n",
    ")\n",
    "\n",
    "print(\"\\nActivité par heure :\")\n",
    "print(hour_counts)\n",
    "\n",
    "# ==============================\n",
    "# CHI² SUR LES INTERETS\n",
    "# ==============================\n",
    "\n",
    "observed = interest_counts.values\n",
    "\n",
    "expected = np.repeat(\n",
    "    observed.sum()/len(observed),\n",
    "    len(observed)\n",
    ")\n",
    "\n",
    "chi2, p_value = chisquare(\n",
    "    observed,\n",
    "    expected\n",
    ")\n",
    "\n",
    "print(\"\\nTest Chi² sur les intérêts\")\n",
    "print(\"Chi² =\", chi2)\n",
    "print(\"p-value =\", p_value)\n",
    "\n",
    "# ==============================\n",
    "# RELATION IA / ACHAT CASQUE\n",
    "# ==============================\n",
    "\n",
    "df_activity[\"watched_ai\"] = (\n",
    "    df_activity[\"action\"]\n",
    "    == \"watched AI talk\"\n",
    ")\n",
    "\n",
    "df_activity[\"bought_headphones\"] = (\n",
    "    df_activity[\"action\"]\n",
    "    == \"bought headphones\"\n",
    ")\n",
    "\n",
    "table = pd.crosstab(\n",
    "    df_activity[\"watched_ai\"],\n",
    "    df_activity[\"bought_headphones\"]\n",
    ")\n",
    "\n",
    "chi2, p, dof, expected = chi2_contingency(table)\n",
    "\n",
    "print(\"\\nRelation IA / Achat casque\")\n",
    "print(\"Chi² =\", chi2)\n",
    "print(\"p-value =\", p)\n",
    "\n",
    "if p < 0.05:\n",
    "    print(\"Relation statistiquement significative\")\n",
    "else:\n",
    "    print(\"Aucune relation significative\")\n"
   ]
